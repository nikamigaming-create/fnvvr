+    // Sleep(1..5) can sleep an entire 15.6 ms Windows timer tick. Use a
+    // process-local high-resolution timer so a 90 Hz runtime does not add
+    // artificial pose age or oscillate between long and catch-up frames.
+    struct FrameWaitTimer {
+        HANDLE handle = CreateWaitableTimerExW(nullptr, nullptr,
+            CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_MODIFY_STATE | SYNCHRONIZE);
+        ~FrameWaitTimer() { if (handle) CloseHandle(handle); }
+    };
+    static FrameWaitTimer frameWaitTimer;
+    LARGE_INTEGER enteredWait; QueryPerformanceCounter(&enteredWait);
+    if (nextTick < static_cast<double>(enteredWait.QuadPart) - periodSec * freq.QuadPart)
+        nextTick = static_cast<double>(enteredWait.QuadPart);
     for (;;) {
         LARGE_INTEGER now; QueryPerformanceCounter(&now);
         double dt = (nextTick - (double)now.QuadPart) / (double)freq.QuadPart;
         if (dt <= 0.0) break;
-        double ms = dt * 1000.0;
-        if (ms > 5.0) ms = 5.0;
-        if (ms < 0.0) ms = 0.0;
-        Sleep((DWORD)ms);
+        if (frameWaitTimer.handle && dt > 0.0005) {
+            LARGE_INTEGER due;
+            due.QuadPart = -static_cast<LONGLONG>((dt - 0.00025) * 10000000.0);
+            if (SetWaitableTimer(frameWaitTimer.handle, &due, 0, nullptr, nullptr, FALSE))
+                WaitForSingleObject(frameWaitTimer.handle, 1000);
+            else
+                SwitchToThread();
+        } else {
+            SwitchToThread();
+        }
     }
